{
  "manifest_version": 3,
  "name": "Anti-Bestemmie",
  "version": "0.1.0",
  "description": "Censura bestemmie italiane in testo (asterischi) e audio (bip) sulle pagine che visiti. Funziona on-device con Gemini Nano + blocklist locale.",
  "default_locale": "it",

  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/core/wordlist.js",
        "src/core/detector.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Anti-Bestemmie",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png"
    }
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "web_accessible_resources": [
    {
      "resources": ["src/offscreen/offscreen.html"],
      "matches": ["<all_urls>"]
    }
  ],

  "minimum_chrome_version": "138"
}
